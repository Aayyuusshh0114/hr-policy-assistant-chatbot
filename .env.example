APP_NAME=HR Policy Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Select groq or gemini. API keys and model names are validated when the
# corresponding provider is used, not while the application starts.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_DEVICE=cpu
EMBEDDING_SUBPROCESS=true
UPLOAD_DIRECTORY=data/uploads
FAISS_INDEX_DIRECTORY=data/indexes
DATABASE_PATH=data/database/hr_assistant.db
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=15
RETRIEVAL_SCORE_THRESHOLD=0.25
MAX_HISTORY_MESSAGES=6
